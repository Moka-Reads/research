
@article{byrd_trust_1987,
	title = {A {Trust} {Region} {Algorithm} for {Nonlinearly} {Constrained} {Optimization}},
	volume = {24},
	issn = {0036-1429, 1095-7170},
	url = {http://epubs.siam.org/doi/10.1137/0724076},
	doi = {10.1137/0724076},
	abstract = {We present a trust region-based method for the general nonlinearly equality constrained optimization problem. The method works by iteratively minimizing a quadratic model of the Lagrangian subject to a possibly relaxed linearization of the problem constraints and a trust region constraint. The model minimization may be done approximately with a dogleg-type approach. We show that this method is globally convergent even if singular or indefinite Hessian approximations are made.},
	language = {en},
	number = {5},
	urldate = {2025-05-22},
	journal = {SIAM Journal on Numerical Analysis},
	author = {Byrd, Richard H. and Schnabel, Robert B. and Shultz, Gerald A.},
	month = oct,
	year = {1987},
	note = {Publisher: Society for Industrial \& Applied Mathematics (SIAM)},
	pages = {1152--1170},
	file = {PDF:/home/mustafif/Zotero/storage/GKE3UPB5/Byrd et al. - 1987 - A Trust Region Algorithm for Nonlinearly Constrained Optimization.pdf:application/pdf},
}

